[Unit]
Description=Plex health watchdog (scan-lag/FUSE-hang/SQLite-stall detection + auto Tier 1 mitigation, alert-only on hard hang)
After=media-stack.service
OnFailure=notify-failure@%n.service

[Service]
Type=simple
Restart=on-failure
RestartSec=5
WorkingDirectory=/home/bear/Claude/media-stack
ExecStart=/usr/bin/python3 /home/bear/Claude/media-stack/scripts/plex-health-monitor.py

[Install]
WantedBy=default.target
