[Unit]
Description=Media Stack (Docker Compose)
# Zurg and rclone-AllDebrid are containerized (zurg/rclone-alldebrid services
# in docker-compose.yml) as of the Phase 1 containerization - no host-level
# zurg.service/rclone-all.service dependency needed anymore; compose brings
# them up itself, in the same tier as every other container.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/bear/Claude/media-stack
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=default.target
