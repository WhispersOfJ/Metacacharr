[Unit]
Description=Plex webhook listener (instant Discord boxart on library.new)
After=media-stack.service
OnFailure=notify-failure@%n.service

[Service]
Type=simple
Restart=on-failure
RestartSec=5
WorkingDirectory=/home/bear/Claude/media-stack
ExecStart=/usr/bin/python3 /home/bear/Claude/media-stack/scripts/plex-webhook-listener.py

[Install]
WantedBy=default.target
