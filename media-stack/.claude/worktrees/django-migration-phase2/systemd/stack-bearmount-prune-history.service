[Unit]
Description=Prune Failed entries from NzbDAV's history (unblocks retry of the same release)
After=media-stack.service
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/bear/Claude/media-stack
ExecStart=/usr/bin/python3 /home/bear/Claude/media-stack/scripts/bearmount-prune-history.py
