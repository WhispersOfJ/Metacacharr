function stack-help --description 'List all stack-* terminal commands for the media stack'
    echo 'Media-stack terminal commands (all hit Control Panel on 192.168.4.20:8420):'
    echo '  stack-status                                    live health of every container'
    echo '  stack-arr <radarr|sonarr> <rss-sync|search-missing|unstick|unstick-importing>'
    echo '                                                   unstick-importing: clear a wedged "importing" download (dead-article test)'
    echo '  stack-arr-import-candidates <radarr|sonarr>'
    echo '                                                   list files ready to manually import'
    echo '  stack-arr-import <radarr|sonarr> <index>'
    echo '                                                   import one, by index from the above'
    echo '  stack-arr-import-all <radarr|sonarr>'
    echo '                                                   import every stuck queue file in one go'
    echo '  stack-arr-backlog <radarr|sonarr>'
    echo '                                                   show the app'"'"'s internal command-queue backlog'
    echo '  stack-arr-missing-aired <radarr|sonarr>          monitored + missing + already aired/released'
    echo '  stack-plex <scan|empty-trash|optimize-db|clean-bundles>'
    echo '  stack-plex-libraries                            list Plex library names'
    echo '  stack-plex-updates                              check for a Plex update (check only)'
    echo '  stack-nzbdav-queue                              show NzbDAV'"'"'s current download queue'
    echo '  stack-nzbdav-history [limit]                    show NzbDAV'"'"'s recent download history'
    echo '  stack-nzbdav-delete-failures                    delete all Failed entries from NzbDAV history'
    echo ''
    echo '  stack-queue-status                              every app'"'"'s queue with live-measured speed/ETA'
    echo '  stack-backlog-status                            every app'"'"'s wanted/missing backlog with throughput ETA'
    echo '  stack-container <restart|stop|start> <name>     control a single container'
    echo '  stack-restart-all [-y]                          restart the whole stack (confirms first)'
    echo ''
    echo 'Diagnostics/audit (added after a live resource+wiring audit found real gaps):'
    echo '  stack-resource-check                            containers missing mem_limit/cpus'
    echo '  stack-log-levels [reset]                        check, or reset, every Servarr app'"'"'s log level'
    echo '  stack-mount-health                              check every known FUSE mountpoint'
    echo '  stack-oom-check                                 containers Docker has recorded an OOM-kill for'
    echo '  stack-perms-check                               config files unreadable by group/other (won'"'"'t be backed up)'
    echo '  stack-cleanuparr-instances                      which *arr apps Cleanuparr actually has connected'
    echo '  stack-arr-logs <app> [lines]                    tail an *arr app'"'"'s container log directly'
    echo '  stack-plex-empty-trash [library ...]            empty trash on one library, or all of them'
    echo '  stack-image-check                               check pinned images for a newer registry digest'
    echo '  stack-disk-config-sizes                                per-app config/ directory size, largest first'
    echo '  stack-version                                   README'"'"'s declared version + live container count'
    echo ''
    echo 'Added in one pass after a real "why haven'"'"'t my shows been processed" session:'
    echo '  stack-command-queue-summary                     backlog across every *arr app at once'
    echo '  stack-arr-recently-added <radarr|sonarr> [limit]    recently added, with file/episode status'
    echo '  stack-plex-duplicates [min_gb]                  movies carrying redundant duplicate files'
    echo '  stack-prowlarr-indexers                         every indexer'"'"'s enabled state + priority'
    echo '  stack-plex-sessions                             who'"'"'s watching what right now'
    echo '  stack-seerr-requests [pending|approved|available|all]'
    echo '                                                   media requests sitting in Seerr'
    echo '  stack-cleanuparr-strikes [limit]                recent stalled/slow/malware strikes'
    echo '  stack-arr-queue-errors                          only queue items already flagged as a problem'
    echo '  stack-notify-test                               send a test message to the Discord webhook'
    echo '  stack-top [cpu|mem] [limit]                     top containers by resource usage'
    echo '  stack-cutoff-unmet <radarr|sonarr> [limit]      items below their quality cutoff'
    echo '  stack-import-lists <radarr|sonarr>              configured import lists + enabled state'
    echo '  stack-nzbdav-stats                              aggregate queue/history counts'
    echo '  stack-plex-recently-added [limit]                what'"'"'s actually visible in Plex now'
    echo ''
    echo 'Ratings + list import (standalone OMDB_KEY/MDBLIST_KEY .env secrets, no Kometa dependency):'
    echo '  stack-rating-imdb <imdb-id>                     a title'"'"'s IMDb rating, via OMDb'
    echo '  stack-rating-mdblist <imdb-id>                  a title'"'"'s MDBList score + IMDb sub-rating'
    echo '  stack-mdblist-import <mdblist-list-url> [--no-search] [--no-monitor] [--dry-run] [--limit N]'
    echo '                                                   import a public MDBList list to Radarr + Sonarr'
    echo ''
    echo 'Letterboxd to Radarr (all take [--no-search] [--no-monitor] [--dry-run]; lists also [--limit N]):'
    echo '  stack-letterboxd-radarr <film-url>              add one Letterboxd film to Radarr'
    echo '  stack-letterboxd-radarr-list <list-url>         add every film in a Letterboxd list'
    echo '  stack-letterboxd-radarr-watchlist <user-url>    add every film in a user'"'"'s watchlist'
    echo '  stack-letterboxd-radarr-watched <user-url>      add every film a user has watched'
    echo '  stack-letterboxd-radarr-collection <coll-url>   add every film in a Letterboxd collection'
    echo '  stack-letterboxd-radarr-filmography <role> <slug>'
    echo '                                                   add a person'"'"'s whole filmography by role'
    echo '  stack-letterboxd-radarr-popular                 add Letterboxd'"'"'s current popular films'
    echo ''
    echo 'new-services batch (PLANS.md Phases 1-3, 2026-08):'
    echo '  stack-watchstate-status                         WatchState tracked items + import schedule'
    echo '  stack-watchstate-import-now                     queue an out-of-schedule import from Plex'
    echo '  stack-watchstate-history [title] [limit]        watch history, optionally filtered to a title'
end
