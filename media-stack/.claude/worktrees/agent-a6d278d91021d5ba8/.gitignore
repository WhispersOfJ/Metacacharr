# Secrets
.env

# Personal/machine-local Claude Code overrides - can contain live API keys
# baked into allowlisted permission commands, not meant to be shared repo state
.claude/settings.local.json
.claude/hookify.*.local.md

# ECC (Enhanced Claude Code) local state - benchmarks, session cache, etc.
# machine-local, regenerated, not source
.ecc/

# Per-app runtime config, databases, caches, logs - all stateful/regenerated,
# several contain plaintext API keys (decypharr/config.json, recyclarr/recyclarr.yml,
# every *arr app's config.xml). None of this belongs in git history.
config/

# control-panel's shared logger (core/logging_config.py) bind-mount target -
# stateful/regenerated, same reasoning as config/ above.
logs/

# Leftover local downloads from NZBGet (removed in 10.1.0, replaced by NzbDAV's
# streaming approach) plus the local media library every arr app writes to
usenet/
media/

# arr-config-sync output (Radarr/Sonarr JSON snapshots) - regenerated, not
# source. Scoped to the repo root only, which used to matter because
# control-panel/services/backups/ was source; that directory was deleted in
# Phase 8a (2026-08-13) once restic removal left it empty. The root-only
# scope stays anyway - it costs nothing and a future services/backups/ would
# be source again.
/backups/

# gstack security reports/local state - stays on this machine, not source
.gstack/

# scripts/audit-tmdb-links.py's default --csv output - regenerated report, not source
tmdb_audit_report.csv

# Vendored upstream clone (nzbdav source, for security/code review) - large,
# re-cloneable via vendor/sync-nzbdav-upstream.sh, not this repo's source
vendor/nzbdav/

# Misc
*.log
.DS_Store
__pycache__/
*.pyc

# Local pytest virtualenv (uv), built from control-panel/requirements.txt
# plus pytest/beautifulsoup4/plexapi - this host has no system httpx.
.venv-test/

# Output of scripts/checkrr-badfiles-report.py (media paths, arr ids)
checkrr-redownload.csv
.checkrr-badfiles.tmp.csv

# Generated report output - checkrr scan results (media paths + arr API keys)
# and one-off audit dumps like radarr-orphan-folders-<date>.json. Every file
# under here is regenerated by a script in scripts/, none of it is source.
data/

# Agent tooling state, machine-local and regenerated, not shared repo state
.letta/
.memsearch/

# Local Ollama model definition for this host, not part of the stack
ClaudeLocal.modelfile

.superpowers/
.env
.upstream-versions.json
.cve-scan-history/
