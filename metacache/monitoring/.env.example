# Copy to monitoring/.env and fill in. docker compose reads it from the compose
# file's directory. Only METACACHE_TMDB_APIKEY is required.

# TMDB API Read Access Token (or v3 API key) — required.
METACACHE_TMDB_APIKEY=

# TVDB v4 API key — episode fallback/augmentation when TMDB lacks episodes.
# Optional: without it, fallbacks never fire. Get one at thetvdb.com → Settings → API.
METACACHE_TVDB_APIKEY=

# ARR apps (optional — blank disables that warm source). Use the host's LAN IP
# so the compose network can reach them ("ARR LAN-wide"):
#   RADARR_URL=http://192.168.4.20:7878
RADARR_URL=http://host.docker.internal:7878
RADARR_APIKEY=
SONARR_URL=http://host.docker.internal:8989
SONARR_APIKEY=

# Grafana admin password (defaults to "admin" when blank).
GRAFANA_ADMIN_PASSWORD=

# Host port mappings (defaults; change if the ports are already taken).
METACACHE_PORT=8765
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
